{
    "version": "2.0",
    "configurationProfile": "mcp-custom-handler",
    "customHandler": {
        "description": {
            "defaultExecutablePath": "python",
            "arguments": ["server.py"]
        },
	"port": "8000",
        "http": {
            "enableProxying": true, 
            "defaultAuthorizationLevel": "anonymous", 
            "routes": [ 
                {
                    "route": "calculator/{operation?}",
                    // Default authorization level is `defaultAuthorizationLevel`
                }
            ]
        }
    }
}